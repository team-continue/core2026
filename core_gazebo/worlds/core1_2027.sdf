      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>-5.3120 -1.7280</point><point>-6.8640 -4.4150</point><point>-5.5630 -5.1660</point><point>-4.0120 -2.4800</point><height>0.150</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>-5.3120 -1.7280</point><point>-6.8640 -4.4150</point><point>-5.5630 -5.1660</point><point>-4.0120 -2.4800</point><height>0.150</height></polyline></geometry></visual>
