<?xml version="1.0"?>
<sdf version="1.9">
  <!-- CoRE-1 の試験のフィールド（make_core1_field.py で作る） -->
  <world name="field">
    <!-- 1kHzにして、200HzのIMUと10HzのLiDARの周期をステップ幅で割り切れるようにする -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- 環境変数 CORE_SCENARIO_FILE のシナリオに従って他ロボットと人間を動かす -->
    <plugin filename="moving_obstacles" name="core_gazebo::MovingObstacles"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 14 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- LiDARは見た目の形状を検出するので、見た目の床をアリーナ全体より広くする -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material><ambient>0.55 0.6 0.55 1</ambient><diffuse>0.55 0.6 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- フィールドは x: -12〜12m、y: -7.5〜7.5m。柵の内側の面がこの境界に一致する。
         柵は高さ140mm。厚さ50mmは仮の値 -->

    <!-- アリーナは内寸 59 x 38 x 高さ15m。フィールドが中央にあると仮定している -->
    <model name="arena_wall_east">
      <static>true</static>
      <pose>29.75 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 39 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 39 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_west">
      <static>true</static>
      <pose>-29.75 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 39 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 39 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_north">
      <static>true</static>
      <pose>0 19.25 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 0.5 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 0.5 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_south">
      <static>true</static>
      <pose>0 -19.25 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 0.5 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 0.5 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 15.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 39 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 39 0.5</size></box></geometry></visual>
      </link>
    </model>

    <!-- フィールドの外の固定物。実物の配置は不明で、すべて仮のもの。
         長方形のアリーナと柵だけだと地図照合が180度回転で曖昧になるので、非対称に置く -->
    <model name="stand_north">
      <static>true</static>
      <pose>-5 16.5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30 5 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 5 5</size></box></geometry></visual>
      </link>
    </model>
    <model name="booth_west">
      <static>true</static>
      <pose>-25 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 8 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 8 3</size></box></geometry></visual>
      </link>
    </model>
    <model name="pillar_east">
      <static>true</static>
      <pose>24 12 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>15</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>15</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="truss">
      <static>true</static>
      <pose>8 -6 12 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 1 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 1 1.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="table_south">
      <static>true</static>
      <pose>15 -15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 1 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- 手順5の試験用にフィールド内へ置いた静止物。実物の配置の情報ではない。
         初期位置 (-6, -2.5) の周り 1.5m は空け、通路は 1.6m 以上残す。
         build_truth_map.py の経路で地図を作れるよう、y=-5.5、y=0、y=5.5、x=±10 の線から機体 1 台分離す。
         static_box_b と柵の間（y: -7.5〜-5.0、幅 2.5m）は blocked_corridor シナリオの通路に使う -->
  
    <!-- 以下は make_core1_field.py が CoRE-1 のフィールドの形から作ったもの。手で直さず、スクリプトで作り直す -->
    <model name="fence_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>-12.0000 -7.4990</point><point>-12.0000 -7.5400</point><point>12.0380 -7.5390</point><point>12.0390 3.5010</point><point>11.9980 3.5000</point><point>11.9980 -7.4980</point><height>0.140</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>-12.0000 -7.4990</point><point>-12.0000 -7.5400</point><point>12.0380 -7.5390</point><point>12.0390 3.5010</point><point>11.9980 3.5000</point><point>11.9980 -7.4980</point><height>0.140</height></polyline></geometry></visual>
      </link>
    </model>
    <model name="fence_2">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>12.0010 7.5380</point><point>-12.0390 7.5390</point><point>-12.0400 -3.5010</point><point>-11.9990 -3.5000</point><point>-11.9990 7.4980</point><point>12.0000 7.4980</point><height>0.140</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>12.0010 7.5380</point><point>-12.0390 7.5390</point><point>-12.0400 -3.5010</point><point>-11.9990 -3.5000</point><point>-11.9990 7.4980</point><point>12.0000 7.4980</point><height>0.140</height></polyline></geometry></visual>
      </link>
    </model>
    <model name="highland_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>-2.4200 -5.9990</point><point>-2.4210 -7.5010</point><point>1.0010 -7.5010</point><point>1.0000 -5.9990</point><point>0.1990 -5.9990</point><point>0.1980 -7.4600</point><point>-0.1190 -7.4600</point><point>-0.1190 -5.9990</point><height>0.200</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>-2.4200 -5.9990</point><point>-2.4210 -7.5010</point><point>1.0010 -7.5010</point><point>1.0000 -5.9990</point><point>0.1990 -5.9990</point><point>0.1980 -7.4600</point><point>-0.1190 -7.4600</point><point>-0.1190 -5.9990</point><height>0.200</height></polyline></geometry></visual>
      </link>
    </model>
    <model name="highland_2">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>-1.5470 -5.9250</point><point>-1.4940 -5.9260</point><point>-1.4940 -5.7960</point><point>-1.3990 -5.7020</point><point>-0.3410 -5.7020</point><point>-0.2470 -5.7960</point><point>-0.2450 -5.9260</point><point>-0.1940 -5.9250</point><point>-0.1940 -5.7750</point><point>-0.3200 -5.6490</point><point>-1.4200 -5.6490</point><point>-1.5470 -5.7740</point><height>0.200</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>-1.5470 -5.9250</point><point>-1.4940 -5.9260</point><point>-1.4940 -5.7960</point><point>-1.3990 -5.7020</point><point>-0.3410 -5.7020</point><point>-0.2470 -5.7960</point><point>-0.2450 -5.9260</point><point>-0.1940 -5.9250</point><point>-0.1940 -5.7750</point><point>-0.3200 -5.6490</point><point>-1.4200 -5.6490</point><point>-1.5470 -5.7740</point><height>0.200</height></polyline></geometry></visual>
      </link>
    </model>
    <model name="highland_3">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>-1.0000 7.5010</point><point>-1.0010 5.9990</point><point>-0.1990 5.9990</point><point>-0.1990 7.4600</point><point>0.1180 7.4600</point><point>0.1190 5.9990</point><point>2.4210 5.9990</point><point>2.4200 7.5010</point><height>0.200</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>-1.0000 7.5010</point><point>-1.0010 5.9990</point><point>-0.1990 5.9990</point><point>-0.1990 7.4600</point><point>0.1180 7.4600</point><point>0.1190 5.9990</point><point>2.4210 5.9990</point><point>2.4200 7.5010</point><height>0.200</height></polyline></geometry></visual>
      </link>
    </model>
    <model name="highland_4">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>0.1940 5.9260</point><point>0.1930 5.7740</point><point>0.3200 5.6490</point><point>1.4200 5.6490</point><point>1.5460 5.7750</point><point>1.5460 5.9250</point><point>1.4950 5.9260</point><point>1.4930 5.7960</point><point>1.3990 5.7020</point><point>0.3410 5.7020</point><point>0.2460 5.7960</point><point>0.2460 5.9260</point><height>0.200</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>0.1940 5.9260</point><point>0.1930 5.7740</point><point>0.3200 5.6490</point><point>1.4200 5.6490</point><point>1.5460 5.7750</point><point>1.5460 5.9250</point><point>1.4950 5.9260</point><point>1.4930 5.7960</point><point>1.3990 5.7020</point><point>0.3410 5.7020</point><point>0.2460 5.7960</point><point>0.2460 5.9260</point><height>0.200</height></polyline></geometry></visual>
      </link>
    </model>
