<?xml version="1.0"?>
<sdf version="1.9">
  <world name="field">
    <!-- 1kHzにして、200HzのIMUと10HzのLiDARの周期をステップ幅で割り切れるようにする -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- 環境変数 CORE_SCENARIO_FILE のシナリオに従って他ロボットと人間を動かす -->
    <plugin filename="moving_obstacles" name="core_gazebo::MovingObstacles"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 14 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- LiDARは見た目の形状を検出するので、見た目の床をアリーナ全体より広くする -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material><ambient>0.55 0.6 0.55 1</ambient><diffuse>0.55 0.6 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- フィールドは x: -12〜12m、y: -7.5〜7.5m。柵の内側の面がこの境界に一致する。
         柵は高さ140mm。厚さ50mmは仮の値 -->
    <model name="fence_east">
      <static>true</static>
      <pose>12.025 0 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></visual>
      </link>
    </model>
    <model name="fence_west">
      <static>true</static>
      <pose>-12.025 0 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></visual>
      </link>
    </model>
    <model name="fence_north">
      <static>true</static>
      <pose>0 7.525 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></visual>
      </link>
    </model>
    <model name="fence_south">
      <static>true</static>
      <pose>0 -7.525 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></visual>
      </link>
    </model>

    <!-- アリーナは内寸 59 x 38 x 高さ15m。フィールドが中央にあると仮定している -->
    <model name="arena_wall_east">
      <static>true</static>
      <pose>29.75 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 39 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 39 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_west">
      <static>true</static>
      <pose>-29.75 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 39 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 39 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_north">
      <static>true</static>
      <pose>0 19.25 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 0.5 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 0.5 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_south">
      <static>true</static>
      <pose>0 -19.25 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 0.5 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 0.5 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 15.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 39 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 39 0.5</size></box></geometry></visual>
      </link>
    </model>

    <!-- フィールドの外の固定物。実物の配置は不明で、すべて仮のもの。
         長方形のアリーナと柵だけだと地図照合が180度回転で曖昧になるので、非対称に置く -->
    <model name="stand_north">
      <static>true</static>
      <pose>-5 16.5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30 5 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 5 5</size></box></geometry></visual>
      </link>
    </model>
    <model name="booth_west">
      <static>true</static>
      <pose>-25 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 8 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 8 3</size></box></geometry></visual>
      </link>
    </model>
    <model name="pillar_east">
      <static>true</static>
      <pose>24 12 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>15</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>15</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="truss">
      <static>true</static>
      <pose>8 -6 12 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 1 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 1 1.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="table_south">
      <static>true</static>
      <pose>15 -15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 1 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- 大域経路を静止物の周りで曲げる変更を試すために、フィールド内へ置いた静止物。実物の配置の情報ではない。
         field.sdf の写しに 8 個の箱を足した。機体の生成が -world field を使うので、ワールドの名前は field のまま。
         run_scenario.py は static_box* の箱だけを読んで距離と接触を判定するので、すべて箱にし、向きで形を変える。
         置き場所の制約（回転したときの外形を含む）:
         - build_truth_map.py の経路（y=0、y=±5.5、x=±10 の線）から機体 1 台分離すため、
           y: 1.1〜4.4 と y: -4.4〜-1.1 の 2 つの帯、x: -8.9〜8.9 の中に置く
         - 静止物どうしのすき間は 2.0m 以上
         - 初期位置 (-6, -2.5) と obstacle_goals シナリオのゴールから 1.5m 以上離す
         高さ 1.0m。Gazebo で見分けやすいよう 1 個ずつ色を変える。a〜d は北の帯、e〜h は南の帯（西から順） -->
    <model name="static_box_a">
      <static>true</static>
      <pose>-6 2.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 2 1</size></box></geometry>
          <material><ambient>0.85 0.25 0.2 1</ambient><diffuse>0.85 0.25 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_b">
      <static>true</static>
      <pose>-2 3 0.5 0 0 0.7853982</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 1.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 1</size></box></geometry>
          <material><ambient>0.95 0.55 0.1 1</ambient><diffuse>0.95 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_c">
      <static>true</static>
      <pose>2 2.5 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 1 1</size></box></geometry>
          <material><ambient>0.9 0.8 0.15 1</ambient><diffuse>0.9 0.8 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_d">
      <static>true</static>
      <pose>6 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 1.4 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 1.4 1</size></box></geometry>
          <material><ambient>0.3 0.7 0.25 1</ambient><diffuse>0.3 0.7 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_e">
      <static>true</static>
      <pose>-3 -3 0.5 0 0 0.7853982</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 1.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 1</size></box></geometry>
          <material><ambient>0.2 0.7 0.75 1</ambient><diffuse>0.2 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_f">
      <static>true</static>
      <pose>0.5 -2.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 2 1</size></box></geometry>
          <material><ambient>0.2 0.35 0.85 1</ambient><diffuse>0.2 0.35 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_g">
      <static>true</static>
      <pose>4 -3.2 0.5 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 1 1</size></box></geometry>
          <material><ambient>0.55 0.3 0.8 1</ambient><diffuse>0.55 0.3 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="static_box_h">
      <static>true</static>
      <pose>7.8 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 1 1</size></box></geometry>
          <material><ambient>0.85 0.3 0.6 1</ambient><diffuse>0.85 0.3 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
