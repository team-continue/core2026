<?xml version="1.0"?>
<sdf version="1.9">
  <world name="field">
    <!-- 1kHzにして、200HzのIMUと10HzのLiDARの周期をステップ幅で割り切れるようにする -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- 環境変数 CORE_SCENARIO_FILE のシナリオに従って他ロボットと人間を動かす -->
    <plugin filename="moving_obstacles" name="core_gazebo::MovingObstacles"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 14 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- LiDARは見た目の形状を検出するので、見た目の床をアリーナ全体より広くする -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material><ambient>0.55 0.6 0.55 1</ambient><diffuse>0.55 0.6 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- フィールドは x: -12〜12m、y: -7.5〜7.5m。柵の内側の面がこの境界に一致する。
         柵は高さ140mm。厚さ50mmは仮の値 -->
    <model name="fence_east">
      <static>true</static>
      <pose>12.025 0 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></visual>
      </link>
    </model>
    <model name="fence_west">
      <static>true</static>
      <pose>-12.025 0 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 15.1 0.14</size></box></geometry></visual>
      </link>
    </model>
    <model name="fence_north">
      <static>true</static>
      <pose>0 7.525 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></visual>
      </link>
    </model>
    <model name="fence_south">
      <static>true</static>
      <pose>0 -7.525 0.07 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24.1 0.05 0.14</size></box></geometry></visual>
      </link>
    </model>

    <!-- アリーナは内寸 59 x 38 x 高さ15m。フィールドが中央にあると仮定している -->
    <model name="arena_wall_east">
      <static>true</static>
      <pose>29.75 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 39 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 39 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_west">
      <static>true</static>
      <pose>-29.75 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 39 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 39 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_north">
      <static>true</static>
      <pose>0 19.25 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 0.5 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 0.5 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="arena_wall_south">
      <static>true</static>
      <pose>0 -19.25 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 0.5 15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 0.5 15</size></box></geometry></visual>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 15.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>60 39 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>60 39 0.5</size></box></geometry></visual>
      </link>
    </model>

    <!-- フィールドの外の固定物。実物の配置は不明で、すべて仮のもの。
         長方形のアリーナと柵だけだと地図照合が180度回転で曖昧になるので、非対称に置く -->
    <model name="stand_north">
      <static>true</static>
      <pose>-5 16.5 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30 5 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 5 5</size></box></geometry></visual>
      </link>
    </model>
    <model name="booth_west">
      <static>true</static>
      <pose>-25 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 8 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 8 3</size></box></geometry></visual>
      </link>
    </model>
    <model name="pillar_east">
      <static>true</static>
      <pose>24 12 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>15</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>15</length></cylinder></geometry></visual>
      </link>
    </model>
    <model name="truss">
      <static>true</static>
      <pose>8 -6 12 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 1 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 1 1.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="table_south">
      <static>true</static>
      <pose>15 -15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 1 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 1 1</size></box></geometry></visual>
      </link>
    </model>
    <!-- 狭い通路の試験用の壁（tools/make_narrow_world.py で作成）。x = -2〜2 の壁に、幅 1.1m（y = -5.0）、1.25m（y = -2.0）、1.6m（y = 1.5）、2.0m（y = 5.0） の通路を開ける。実物の配置の情報ではない -->
    <model name="static_box_narrow_0">
      <static>true</static>
      <pose>0 -6.525 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 1.95 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 1.95 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="static_box_narrow_1">
      <static>true</static>
      <pose>0 -3.538 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 1.825 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 1.825 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="static_box_narrow_2">
      <static>true</static>
      <pose>0 -0.3375 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 2.075 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 2.075 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="static_box_narrow_3">
      <static>true</static>
      <pose>0 3.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 1.7 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 1.7 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="static_box_narrow_4">
      <static>true</static>
      <pose>0 6.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 1.5 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 1.5 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
