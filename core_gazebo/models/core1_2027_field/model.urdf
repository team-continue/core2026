<?xml version="1.0"?>
<!-- CoRE-1 の試験のフィールドの構造物（core1_2027_outlines.yaml の外形 47 個を押し出したもの）。make_core1_field_model.py が作る。手で直さず、スクリプトで作り直す -->
<robot name="core1_2027_field">
  <link name="field">
    <inertial><mass value="1000.0"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
    <visual><origin xyz="0.000 0.000 0" rpy="0 0 0"/><geometry><mesh filename="package://core_gazebo/models/core1_2027_field/meshes/core1_2027_field.stl"/></geometry><material name="field_grey"><color rgba="0.7 0.7 0.72 1"/></material></visual>
    <collision><origin xyz="0.000 0.000 0" rpy="0 0 0"/><geometry><mesh filename="package://core_gazebo/models/core1_2027_field/meshes/core1_2027_field.stl"/></geometry></collision>
  </link>
  <gazebo><static>true</static></gazebo>
</robot>
