<launch>
  <!-- Navigation -->
  <include file="$(find-pkg-share core_launch)/launch/navigation.launch.py">
    <arg name="environment" value="real"/>
    <arg name="use_localization" value="true"/>
    <arg name="use_rviz" value="false"/>
  </include>

  <!-- Shooter -->
  <include file="$(find-pkg-share core_shooter)/launch/shooter.launch.py"/>

  <!-- Enemy Detection & Camera-->
  <include file="$(find-pkg-share core_enemy_detection)/launch/detection.launch.py"/>
  <include file="$(find-pkg-share core_camera)/launch/camera.launch.py"/>
  <executable cmd="v4l2" output="screen"/>

  <!-- Utility -->
  <include file="$(find-pkg-share core_mode)/launch/mode.launch.py"/>
  <include file="$(find-pkg-share core_ros_player_controller)/launch/wireless_parser_node.launch.py"/>

  <!-- Behavior System -->
  <include file="$(find-pkg-share core_behavior_system)/launch/behavior_system.launch.py"/>

</launch>