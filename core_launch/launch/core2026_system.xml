<launch>
  <!-- ROS 2 Bridge (Android 操作UI用。/bridge/connected を core_mode の diagnostic が監視する) -->
  <node pkg="ros2_ws_bridge" exec="bridge" name="ros2_websocket_bridge" output="screen">
    <param name="port" value="8765"/>
  </node>

  <!-- Navigation -->
  <include file="$(find-pkg-share core_launch)/launch/navigation.launch.py">
    <arg name="environment" value="real"/>
    <!-- <arg name="use_localization" value="true"/> -->
    <!-- <arg name="use_rviz" value="false"/> -->
  </include>

  <!-- Body Controller -->
  <include file="$(find-pkg-share core_body_controller)/launch/body_controller.launch.py"/>

  <!-- Shooter -->
  <include file="$(find-pkg-share core_shooter)/launch/shooter.launch.py"/>

  <!-- Enemy Detection & Camera-->
  <include file="$(find-pkg-share core_enemy_detection)/launch/test.launch.py"/>
  <!-- <include file="$(find-pkg-share core_camera)/launch/camera2.launch.py"/>
  <executable cmd="v4l2" output="screen"/> -->

  <!-- Utility -->
  <include file="$(find-pkg-share core_mode)/launch/mode.launch.py"/>

  <!-- Behavior System -->
  <include file="$(find-pkg-share core_behavior_system)/launch/behavior_system.launch.py"/>

</launch>