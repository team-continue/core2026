  <link name="right_yaw_link">
  </link>
  <joint name="right_yaw_joint" type="${'fixed' if gazebo else 'continuous'}">
    <parent link="base_link"/>
    <child link="right_yaw_link"/>
    <origin xyz="0.000197571 -0.174999 0.254273" rpy="0 0 3.14159"/>
    <xacro:unless value="${gazebo}">
