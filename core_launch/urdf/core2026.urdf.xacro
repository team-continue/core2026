    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <xacro:unless value="${gazebo}">
      <axis xyz="0 0 1"/>
    </xacro:unless>
  </joint>

  <!-- 左右の砲塔（yaw と pitch）。Gazebo では固定 -->
  <link name="left_yaw_link">
