<?xml version="1.0"?>
<!-- core2026 の機体。形・質量・関節・センサの取り付けは CoRE2026_Sim（Unity）の CoRE2026_Machine.prefab から
     作った簡易モデル（~/core2026_sim_description の core2026_sim.urdf.xacro。gen_urdf.py で生成）を、core2026 の
     木に組み替えたもの:
       base_link    = 上半身（Unity の LowerYawAxisJoint より上。LiDAR・IMU・砲塔が付く）を床に投影した中心
       chassis_link = 駆動部（Unity の RootLink: 車台と 4 輪）。上半身の下で回る（関節 base_to_chassis）
     実機の robot_state_publisher と Gazebo（gazebo:=true）で同じものを使う -->
<robot name="core2026" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mid-360 の取り付け（base_link から livox_frame）。既定は Unity の機体の Mid-360 の計測点（Mid-360_ros の
       Sensor）: 前へ 0.132m、床から 0.484m、上下逆さ -->
  <xacro:arg name="lidar_x" default="0.1321"/>
  <xacro:arg name="lidar_y" default="0.000149"/>
  <xacro:arg name="lidar_height" default="0.484173"/>
  <xacro:arg name="lidar_roll" default="3.14159"/>
  <xacro:arg name="lidar_pitch" default="0.0"/>
  <xacro:arg name="lidar_yaw" default="0.00113"/>
  <!-- Damiao IMU の取り付け。既定は Unity の機体の IMU（前へ 0.132m、床から 0.504m、上下逆さ） -->
  <xacro:arg name="damiao_imu_x" default="0.1321"/>
  <xacro:arg name="damiao_imu_y" default="0.000149"/>
  <xacro:arg name="damiao_imu_z" default="0.504182"/>
  <xacro:arg name="damiao_imu_roll" default="3.14159"/>
  <!-- Gazebo で使うとき true。可動の関節（腰・砲塔・車輪）を固定にし、シミュレーションの定義を読む -->
  <xacro:arg name="gazebo" default="false"/>
  <!-- 以前の衝突の箱の高さ。今の形は Unity の機体の形なので使わない（launch が渡すので引数だけ残す） -->
  <xacro:arg name="body_height" default="0.95"/>
  <!-- 以下は Gazebo（core2026.gazebo.xacro）だけで使う -->
  <xacro:arg name="rear_lidar" default="false"/>
  <xacro:arg name="rear_lidar_x" default="-0.44"/>
  <xacro:arg name="rear_lidar_height" default="0.25"/>
  <xacro:arg name="drive_dead_time" default="0.0"/>
  <xacro:arg name="slip_longitudinal_ratio" default="1.0"/>
  <xacro:arg name="slip_lateral_ratio" default="1.0"/>
  <xacro:arg name="slip_yaw_ratio" default="1.0"/>
  <xacro:arg name="slip_time_constant" default="0.0"/>
  <xacro:arg name="slip_static_friction_accel" default="0.0"/>
  <xacro:arg name="slip_kinetic_friction_accel" default="0.0"/>
  <xacro:arg name="slip_noise_ratio" default="0.0"/>
  <xacro:arg name="slip_noise_time" default="0.5"/>

  <!-- 引数は文字列なので、式で使えるよう真偽値にする -->
  <xacro:property name="gazebo" value="${'$(arg gazebo)'.lower() == 'true'}"/>
  <xacro:property name="rear_lidar" value="${'$(arg rear_lidar)'.lower() == 'true'}"/>
  <!-- FAST-LIO の mid360.yaml の extrinsic_T の符号を反転した値（LiDAR 座標系での IMU の位置） -->
  <xacro:property name="livox_imu_x" value="0.011"/>
  <xacro:property name="livox_imu_y" value="0.02329"/>
  <xacro:property name="livox_imu_z" value="-0.04412"/>

  <material name="frame"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="turret"><color rgba="0.2 0.45 0.85 1"/></material>
  <material name="wheel"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- ここから base_link・body_link・chassis_link・砲塔・車輪・カメラ。形は Unity の Collider の箱と円柱。
       Gazebo の衝突形状は車輪を除くすべて（いちばん低い所でも床から 0.048m 浮く。機体は omni_force_drive の
       力で動かす） -->
  <!-- 上半身（Unity の LowerYawAxisJoint より上）。形だけ。KDL は慣性を持つルートを扱えない -->
  <link name="base_link">
    <visual>
      <origin xyz="0.056 6.31995e-05 0.744773" rpy="1.5708 0 0.00113"/>
      <geometry><box size="0.012 0.4 0.012"/></geometry>
