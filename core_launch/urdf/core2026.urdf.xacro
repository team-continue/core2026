  <joint name="right_pitch_joint" type="${'fixed' if gazebo else 'continuous'}">
    <parent link="right_yaw_link"/>
    <child link="right_pitch_link"/>
    <origin xyz="-3.54832e-06 0.00315283 0.0265"/>
    <xacro:unless value="${gazebo}">
      <axis xyz="0 1 0"/>
    </xacro:unless>
  </joint>

  <!-- 車輪（メカナム）。Gazebo では固定にし、衝突形状を持たせない -->
  <link name="wheel1_link">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 1.57079 3.14159"/>
      <geometry><cylinder length="0.04" radius="0.065"/></geometry>
      <material name="wheel"/>
    </visual>
    <xacro:unless value="${gazebo}">
      <collision>
        <origin xyz="0 0 0"/>
        <geometry><sphere radius="0.065"/></geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00105625" ixy="0" ixz="0" iyy="0.000528125" iyz="0" izz="0.000528125"/>
    </inertial>
  </link>
  <joint name="wheel1_joint" type="${'fixed' if gazebo else 'continuous'}">
    <parent link="chassis_link"/>
    <child link="wheel1_link"/>
    <origin xyz="0.265 0.265 0.065" rpy="0 0 0.785398"/>
    <xacro:unless value="${gazebo}">
      <axis xyz="1 0 0"/>
    </xacro:unless>
  </joint>

  <link name="wheel2_link">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 1.57079 3.14159"/>
      <geometry><cylinder length="0.04" radius="0.065"/></geometry>
      <material name="wheel"/>
    </visual>
    <xacro:unless value="${gazebo}">
      <collision>
        <origin xyz="0 0 0"/>
        <geometry><sphere radius="0.065"/></geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00105625" ixy="0" ixz="0" iyy="0.000528125" iyz="0" izz="0.000528125"/>
    </inertial>
  </link>
  <joint name="wheel2_joint" type="${'fixed' if gazebo else 'continuous'}">
    <parent link="chassis_link"/>
    <child link="wheel2_link"/>
    <origin xyz="-0.265 0.265 0.065" rpy="0 0 2.35619"/>
    <xacro:unless value="${gazebo}">
      <axis xyz="1 0 0"/>
    </xacro:unless>
  </joint>

  <link name="wheel3_link">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 1.57079 3.14159"/>
      <geometry><cylinder length="0.04" radius="0.065"/></geometry>
      <material name="wheel"/>
    </visual>
    <xacro:unless value="${gazebo}">
      <collision>
        <origin xyz="0 0 0"/>
        <geometry><sphere radius="0.065"/></geometry>
      </collision>
    </xacro:unless>
    <inertial>
