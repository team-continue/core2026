      <geometry><box size="0.5 0.012 0.012"/></geometry>
    </collision>
  </link>

  <!-- 上半身の質量 -->
  <link name="body_link">
    <inertial>
      <origin xyz="0 0 0.529773"/>
      <mass value="6.0"/>
      <inertia ixx="0.46952" ixy="7.96077e-11" ixz="0" iyy="0.46955" iyz="0" izz="0.25017"/>
    </inertial>
  </link>
  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
  </joint>

  <!-- 駆動部（Unity の RootLink: 車台と車輪）。上半身の下で回る。腰の角度が 0 のとき base_link と同じ向き -->
