    <parent link="chassis_link"/>
    <child link="wheel3_link"/>
    <origin xyz="-0.265 -0.265 0.065" rpy="0 0 -2.35619"/>
    <xacro:unless value="${gazebo}">
      <axis xyz="1 0 0"/>
    </xacro:unless>
  </joint>

  <link name="wheel4_link">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 1.57079 3.14159"/>
      <geometry><cylinder length="0.04" radius="0.065"/></geometry>
      <material name="wheel"/>
    </visual>
    <xacro:unless value="${gazebo}">
      <collision>
        <origin xyz="0 0 0"/>
        <geometry><sphere radius="0.065"/></geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00105625" ixy="0" ixz="0" iyy="0.000528125" iyz="0" izz="0.000528125"/>
    </inertial>
  </link>
  <joint name="wheel4_joint" type="${'fixed' if gazebo else 'continuous'}">
    <parent link="chassis_link"/>
    <child link="wheel4_link"/>
    <origin xyz="0.265 -0.265 0.065" rpy="0 0 -0.785398"/>
    <xacro:unless value="${gazebo}">
      <axis xyz="1 0 0"/>
    </xacro:unless>
  </joint>

  <!-- 上のカメラ（Unity の TopCamera）-->
  <link name="camera1_link"/>
  <joint name="base_link_to_camera1_link" type="fixed">
    <parent link="base_link"/>
    <child link="camera1_link"/>
    <origin xyz="0.0854216 9.65787e-05 0.931562" rpy="3.14159 0.610865 -5.30718e-06"/>
  </joint>
  <!-- 砲塔のカメラ -->
  <link name="left_turret_camera_frame"/>
  <joint name="left_pitch_link_to_left_turret_camera_frame" type="fixed">
    <parent link="left_pitch_link"/>
    <child link="left_turret_camera_frame"/>
    <origin xyz="-0.167241 0.00846442 0.11" rpy="0 0 -3.14046"/>
  </joint>
  <link name="right_turret_camera_frame"/>
  <joint name="right_pitch_link_to_right_turret_camera_frame" type="fixed">
    <parent link="right_pitch_link"/>
    <child link="right_turret_camera_frame"/>
    <origin xyz="-0.167228 -0.0088429 0.11" rpy="0 0 3.14159"/>
  </joint>

  <!-- 実機のドライバと同じフレーム名。点群の原点になる -->
  <link name="livox_frame"/>
  <joint name="base_to_livox" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_height)"
            rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
  </joint>

  <link name="livox_imu_link"/>
  <joint name="livox_to_imu" type="fixed">
    <parent link="livox_frame"/>
    <child link="livox_imu_link"/>
    <origin xyz="${livox_imu_x} ${livox_imu_y} ${livox_imu_z}"/>
  </joint>

  <xacro:if value="${gazebo and rear_lidar}">
    <link name="livox_rear_frame"/>
    <joint name="base_to_livox_rear" type="fixed">
      <parent link="base_link"/>
      <child link="livox_rear_frame"/>
      <origin xyz="$(arg rear_lidar_x) 0 $(arg rear_lidar_height)" rpy="0 0 ${pi}"/>
    </joint>
  </xacro:if>

  <link name="damiao_imu_link"/>
  <joint name="base_to_damiao_imu" type="fixed">
    <parent link="base_link"/>
    <child link="damiao_imu_link"/>
    <origin xyz="$(arg damiao_imu_x) $(arg damiao_imu_y) $(arg damiao_imu_z)" rpy="$(arg damiao_imu_roll) 0 0"/>
  </joint>

  <xacro:if value="${gazebo}">
    <xacro:include filename="$(find core_gazebo)/urdf/core2026.gazebo.xacro"/>
  </xacro:if>
</robot>
