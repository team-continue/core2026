<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>core_launch</name>
  <version>0.1.0</version>
  <description>Launch files for bringing up core2026 robot nodes.</description>
  <maintainer email="jane.doe@example.com">Jane Doe</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>core_body_controller</exec_depend>
  <exec_depend>core_damiao_imu</exec_depend>

  <!-- 自律移動（設計: 1 台構成・コンポーネント版） -->
  <!-- sim_*.launch.py は core_gazebo を使う。core_gazebo が URDF のためにこのパッケージに依存するので、ここには書かない -->
  <exec_depend>core_localization</exec_depend>
  <exec_depend>core_msgs</exec_depend>
  <exec_depend>core_perception</exec_depend>
  <exec_depend>core_planning</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>lidar_localization_ros2</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
