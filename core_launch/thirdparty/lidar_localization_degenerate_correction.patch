+#ifndef LIDAR_LOCALIZATION_DEGENERATE_CORRECTION_POLICY_HPP_
+#define LIDAR_LOCALIZATION_DEGENERATE_CORRECTION_POLICY_HPP_
+
+#include <cmath>
+#include <cstddef>
+#include <limits>
+
+#include <Eigen/Dense>
+#include <Eigen/Eigenvalues>
+
+namespace lidar_localization
+{
+
+// 照合の結果のうち、点群が水平のある向きをほとんど決められない（退化した）ときに、その向きの補正を捨てる。
+//
+// NDT の評価値のヘッセ行列の符号を反転し、対応の数で割った 1 点あたりの情報行列の、水平の並進（x, y）の
+// 2x2 の部分を固有分解する。固有値が min_information より小さい向きは、点群がその向きの位置を決められないので、
+// 照合の補正（結果 - 初期値）のその向きの成分を捨て、初期値（LIO で進めた姿勢）のままにする。
+// 例: LiDAR が前しか見えず、正面の壁が届く距離の外にあると、前後の向きは天井・床・左右の壁の点しかなく、
+// NDT の格子の境目で生じる評価値のわずかな傾きに引かれて、補正が数十 cm 動く。
+// 向き（yaw）と高さ、傾きは照合の結果のまま。
+struct DegenerateCorrectionResult
+{
+  Eigen::Matrix4f pose{Eigen::Matrix4f::Identity()};
+  // 補正を捨てた向きの数（0〜2）
+  int projected_directions{0};
+  // 水平の情報行列の小さい方の固有値 [1/m^2]（1 点あたり）。計算できなければ NaN
+  double planar_information_min{std::numeric_limits<double>::quiet_NaN()};
+};
+
+inline DegenerateCorrectionResult projectDegenerateTranslation(
+  const Eigen::Matrix4f & seed,
+  const Eigen::Matrix4f & result,
+  const Eigen::Matrix<double, 6, 6> & score_hessian,
+  std::size_t correspondence_count,
+  double min_information)
+{
+  DegenerateCorrectionResult out;
+  out.pose = result;
+  if (correspondence_count == 0 || !score_hessian.allFinite() || !std::isfinite(min_information)) {
+    return out;
+  }
+  // NDT_OMP は評価値を最大にするので、符号を反転して対称にし、対応の数で割る（analyzeRegistrationHessian と同じ）
+  const Eigen::Matrix<double, 6, 6> information =
+    -0.5 * (score_hessian + score_hessian.transpose()) / static_cast<double>(correspondence_count);
+  const Eigen::Matrix2d planar = information.block<2, 2>(0, 0);
+  Eigen::SelfAdjointEigenSolver<Eigen::Matrix2d> solver(planar);
+  if (solver.info() != Eigen::Success || !solver.eigenvalues().allFinite()) {
+    return out;
+  }
+  out.planar_information_min = solver.eigenvalues()(0);
+  const Eigen::Vector2d correction(
+    static_cast<double>(result(0, 3) - seed(0, 3)),
+    static_cast<double>(result(1, 3) - seed(1, 3)));
+  Eigen::Vector2d kept = Eigen::Vector2d::Zero();
+  for (int i = 0; i < 2; ++i) {
+    const Eigen::Vector2d direction = solver.eigenvectors().col(i);
+    if (solver.eigenvalues()(i) >= min_information) {
+      kept += direction * direction.dot(correction);
+    } else {
+      ++out.projected_directions;
+    }
+  }
+  out.pose(0, 3) = seed(0, 3) + static_cast<float>(kept.x());
+  out.pose(1, 3) = seed(1, 3) + static_cast<float>(kept.y());
+  return out;
+}
+
+}  // namespace lidar_localization
+
+#endif  // LIDAR_LOCALIZATION_DEGENERATE_CORRECTION_POLICY_HPP_
