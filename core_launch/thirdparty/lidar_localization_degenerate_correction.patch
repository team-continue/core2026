+// degenerate_correction_policy.hpp の試験。Release（NDEBUG）でも確かめるよう、assert を使わずに失敗を数える
+#include <cmath>
+#include <cstdio>
+#include <limits>
+
+#include <Eigen/Dense>
+
+#include "lidar_localization/degenerate_correction_policy.hpp"
+
+namespace ll = lidar_localization;
+
+namespace
+{
+int failures = 0;
+
+void expect(bool condition, const char * what)
+{
+  if (!condition) {
+    std::fprintf(stderr, "失敗: %s\n", what);
+    ++failures;
+  }
+}
+
+bool near(double a, double b, double tolerance = 1e-5)
+{
+  return std::abs(a - b) <= tolerance;
+}
+
+Eigen::Matrix4f translation(float x, float y, float z)
+{
+  Eigen::Matrix4f m = Eigen::Matrix4f::Identity();
+  m(0, 3) = x;
+  m(1, 3) = y;
+  m(2, 3) = z;
+  return m;
+}
+
+// 1 点あたりの情報が対角で (ix, iy) になる、評価値のヘッセ行列（対応の数 count）
+Eigen::Matrix<double, 6, 6> scoreHessian(double ix, double iy, std::size_t count)
+{
+  Eigen::Matrix<double, 6, 6> h = -Eigen::Matrix<double, 6, 6>::Identity() * static_cast<double>(count);
+  h(0, 0) = -ix * static_cast<double>(count);
+  h(1, 1) = -iy * static_cast<double>(count);
+  return h;
+}
+}  // namespace
+
+int main()
+{
+  const Eigen::Matrix4f seed = translation(1.0f, 2.0f, 0.0f);
+  {
+    // x の情報が小さいので、x の補正を捨てて y の補正だけ残す。高さはそのまま
+    Eigen::Matrix4f result = translation(1.3f, 2.1f, 0.05f);
+    result.block<3, 3>(0, 0) = Eigen::AngleAxisf(0.01f, Eigen::Vector3f::UnitZ()).toRotationMatrix();
+    const auto out = ll::projectDegenerateTranslation(seed, result, scoreHessian(0.3, 20.0, 3000), 3000, 1.0);
+    expect(out.projected_directions == 1, "x だけ捨てる");
+    expect(near(out.pose(0, 3), 1.0), "x は初期値のまま");
+    expect(near(out.pose(1, 3), 2.1), "y は照合の結果");
+    expect(near(out.pose(2, 3), 0.05), "高さは照合の結果");
+    expect(out.pose.block<3, 3>(0, 0).isApprox(result.block<3, 3>(0, 0)), "向きは照合の結果");
+    expect(near(out.planar_information_min, 0.3), "小さい方の固有値");
+  }
+  {
+    // 斜めに退化した向き。情報の小さい向き (1, 1)/√2 の成分だけを捨てる
+    Eigen::Matrix<double, 6, 6> h = scoreHessian(0.0, 0.0, 100);
+    // 情報行列 [[a, b], [b, a]] の固有値は a+b（向き (1,1)）と a-b（向き (1,-1)）
+    h(0, 0) = -10.0 * 100.0;
+    h(1, 1) = -10.0 * 100.0;
+    h(0, 1) = 9.8 * 100.0;
+    h(1, 0) = 9.8 * 100.0;
+    const Eigen::Matrix4f result = translation(1.2f, 2.2f, 0.0f);
+    const auto out = ll::projectDegenerateTranslation(seed, result, h, 100, 1.0);
+    // 情報行列は [[10, -9.8], [-9.8, 10]]。弱い向きは (1, 1)/√2（固有値 0.2）
+    expect(out.projected_directions == 1, "斜めの向きを 1 つ捨てる");
+    expect(near(out.pose(0, 3), 1.0, 1e-4) && near(out.pose(1, 3), 2.0, 1e-4), "(1,1) 向きの補正を捨てる");
+    expect(near(out.planar_information_min, 0.2, 1e-9), "弱い向きの固有値 0.2");
+  }
+  {
+    // どちらの向きも十分なら、照合の結果をそのまま使う
+    const Eigen::Matrix4f result = translation(1.05f, 1.97f, 0.0f);
+    const auto out = ll::projectDegenerateTranslation(seed, result, scoreHessian(5.0, 8.0, 500), 500, 1.0);
+    expect(out.projected_directions == 0, "捨てない");
+    expect(out.pose.isApprox(result), "結果のまま");
+  }
+  {
+    // 対応がない、またはヘッセ行列が有限でないときは、何もしない
+    const Eigen::Matrix4f result = translation(1.5f, 2.5f, 0.0f);
+    const auto none = ll::projectDegenerateTranslation(seed, result, scoreHessian(0.1, 0.1, 10), 0, 1.0);
+    expect(none.projected_directions == 0 && none.pose.isApprox(result), "対応なしは結果のまま");
+    expect(std::isnan(none.planar_information_min), "対応なしは NaN");
+    Eigen::Matrix<double, 6, 6> bad = scoreHessian(0.1, 0.1, 10);
+    bad(0, 0) = std::numeric_limits<double>::quiet_NaN();
+    const auto nan = ll::projectDegenerateTranslation(seed, result, bad, 10, 1.0);
+    expect(nan.projected_directions == 0 && nan.pose.isApprox(result), "NaN は結果のまま");
+  }
+  {
+    // 閾値 0 なら、情報が負（評価値の鞍点）の向き以外は捨てない
+    const Eigen::Matrix4f result = translation(1.2f, 2.2f, 0.0f);
+    const auto out = ll::projectDegenerateTranslation(seed, result, scoreHessian(0.01, 3.0, 100), 100, 0.0);
+    expect(out.projected_directions == 0 && out.pose.isApprox(result), "閾値 0 は捨てない");
+  }
+  if (failures == 0) {
+    std::printf("degenerate_correction_policy: 全て合格\n");
+  }
+  return failures == 0 ? 0 : 1;
+}
