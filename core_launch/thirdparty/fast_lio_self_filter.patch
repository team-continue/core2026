+// lidar_nav: 自機の除去（機体の箱）のために追加。avia_handler（lidar_type 1）だけが使い、
+// ほかの handler は上流のまま（blind の球だけ）
+struct SelfFilter
+{
+  bool enabled = false;
+  // base_link の x・y 方向の箱の半分の長さ [m]
+  double half_length = 0.0;
+  double half_width = 0.0;
+  // base_link（床に投影した機体中心）での箱の上面の高さ [m]（機体の上面と余裕）
+  double top_height = 0.0;
+  // 0 より大きければ、xy は箱ではなくこの半径 [m] の円柱で判定する（上部の下で駆動部が回る機体）
+  double radius = 0.0;
+  // LiDAR の点を base_link へ移す変換（p_base = R p_lidar + T）。T は base_link で表した LiDAR の位置
+  Eigen::Matrix3d R_base_lidar = Eigen::Matrix3d::Identity();
+  Eigen::Vector3d T_base_lidar = Eigen::Vector3d::Zero();
+};
