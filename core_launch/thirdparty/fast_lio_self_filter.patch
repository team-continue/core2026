+// lidar_nav: 自機の除去。base_link で xy が機体の箱の中にあり、高さが箱の上面以下の点を自機とみなす。
+// LiDAR は機体の前の端の低い所にあるので、LiDAR より上の機体の面も除く。
+// core_perception の selectObstaclePoints と同じ判定
+bool Preprocess::in_self_box(const PointType &pt) const
+{
+  if (!self_filter.enabled)
+    return false;
+  const Eigen::Vector3d base = self_filter.R_base_lidar * Eigen::Vector3d(pt.x, pt.y, pt.z) + self_filter.T_base_lidar;
+  if (base.z() > self_filter.top_height)
+    return false;
+  if (self_filter.radius > 0.0)
+    return base.x() * base.x() + base.y() * base.y() <= self_filter.radius * self_filter.radius;
+  return std::abs(base.x()) <= self_filter.half_length && std::abs(base.y()) <= self_filter.half_width;
+}
