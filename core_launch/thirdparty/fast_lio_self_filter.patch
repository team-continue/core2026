+// lidar_nav: 地図のボクセル（filter_size_map の格子）に点がまだないときだけ点を足し、すでにある点は置き換えない。
+// 上流の更新は、ボクセルの中の点を「ボクセルの中心に最も近い点」へ置き換え続ける。足す点の位置にはその周期の姿勢の
+// 推定のぶれが乗るので、中心へ寄る向きにぶれた周期の点ほど残り、地図の面が中心へ寄って、照合がそれを追う。床や壁の
+// ような座標軸にそろった広い面では、これが積み重なり、姿勢が面と中心の距離（最大でボクセルの半分）までずれていく
+void map_incremental_keep_existing()
+{
+    PointVector PointToAdd;
+    PointToAdd.reserve(feats_down_size);
+    // 同じ周期の点どうしが同じボクセルに入ったときは、最初の点だけを足す
+    std::unordered_set<int64_t> batch_voxels;
+    batch_voxels.reserve(2 * feats_down_size);
+    PointVector in_voxel;
+    const float size = filter_size_map_min;
+    for (int i = 0; i < feats_down_size; i++)
+    {
+        PointType &point = feats_down_world->points[i];
+        pointBodyToWorld(&(feats_down_body->points[i]), &point);
+        const int64_t ix = static_cast<int64_t>(floor(point.x / size));
+        const int64_t iy = static_cast<int64_t>(floor(point.y / size));
+        const int64_t iz = static_cast<int64_t>(floor(point.z / size));
+        // 各軸 21 ビット（0.5m の格子で ±500km）に収めて 1 つの鍵にする
+        const int64_t key = ((ix & 0x1FFFFF) << 42) | ((iy & 0x1FFFFF) << 21) | (iz & 0x1FFFFF);
+        if (!batch_voxels.insert(key).second) continue;
+        BoxPointType box;
+        box.vertex_min[0] = ix * size;
+        box.vertex_min[1] = iy * size;
+        box.vertex_min[2] = iz * size;
+        for (int axis = 0; axis < 3; axis++) box.vertex_max[axis] = box.vertex_min[axis] + size;
+        // 照合で探した近傍の点が同じボクセルにあれば、点はある。なければ箱で探して確かめる
+        bool occupied = false;
+        for (const auto &near : Nearest_Points[i])
+        {
+            if (near.x >= box.vertex_min[0] && near.x < box.vertex_max[0] && near.y >= box.vertex_min[1] &&
+                near.y < box.vertex_max[1] && near.z >= box.vertex_min[2] && near.z < box.vertex_max[2])
+            {
+                occupied = true;
+                break;
+            }
+        }
+        if (!occupied)
+        {
+            ikdtree.Box_Search(box, in_voxel);
+            occupied = !in_voxel.empty();
+        }
+        if (!occupied) PointToAdd.push_back(point);
+    }
+    double st_time = omp_get_wtime();
+    ikdtree.Add_Points(PointToAdd, false);
+    add_point_size = PointToAdd.size();
+    kdtree_incremental_time = omp_get_wtime() - st_time;
+}
