diff --git a/include/lidar_localization/map_to_odom_step_policy.hpp b/include/lidar_localization/map_to_odom_step_policy.hpp
new file mode 100644
index 0000000..ecf65a5
--- /dev/null
+++ b/include/lidar_localization/map_to_odom_step_policy.hpp
@@ -0,0 +1,187 @@
+#ifndef LIDAR_LOCALIZATION_MAP_TO_ODOM_STEP_POLICY_HPP_
+#define LIDAR_LOCALIZATION_MAP_TO_ODOM_STEP_POLICY_HPP_
+
+#include <cmath>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include <Eigen/Geometry>
+
+#include "lidar_localization/alignment_diagnostics_policy.hpp"
+
+namespace lidar_localization
+{
+
+// Step limiting of the broadcast map -> odom.
+//
+// An accepted registration replaces the map -> odom anchor at once, so the
+// map -> base_link read off TF jumps by the whole correction.  With a step
+// limit the broadcast map -> odom instead moves toward the accepted one (the
+// target) by at most max_translation_m and max_yaw_deg per publish cycle; the
+// rest carries over to the following cycles, including the frozen republish on
+// rejected scans.  The registration seed keeps using the target.
+//
+// Steps are measured at the robot.  A rotation of map -> odom turns the odom
+// frame about the map origin, so far from the odom origin even a small heading
+// correction moves the translation part of map -> odom a lot while the robot
+// itself barely moves.  Both transforms are therefore applied to the robot's
+// position in odom (the pivot): the translation is the distance between the
+// two robot positions, and the rotation turns about the robot.
+
+constexpr double kMapToOdomStepRadiansToDegrees = 180.0 / 3.14159265358979323846;
+
+struct MapToOdomStepParams
+{
+  // Largest move of the robot's map position per publish cycle [m]. 0 = no limit.
+  double max_translation_m{0.0};
+  // Largest heading change per publish cycle [deg]. 0 = no limit.
+  double max_yaw_deg{0.0};
+};
+
+inline bool isMapToOdomStepLimitEnabled(const MapToOdomStepParams & params)
+{
+  return params.max_translation_m > 0.0 || params.max_yaw_deg > 0.0;
+}
+
+// Yaw (ZYX) of a rotation, as an absolute angle in degrees; the same measure
+// as computeAlignmentCorrectionMetrics.
+inline double absoluteYawDeg(const Eigen::Matrix3d & rotation)
+{
+  return std::abs(std::atan2(rotation(1, 0), rotation(0, 0))) * kMapToOdomStepRadiansToDegrees;
+}
+
+struct MapToOdomDifference
+{
+  double translation_m{0.0};
+  double yaw_deg{0.0};
+};
+
+// How far the robot at pivot_in_odom moves on the map, and how much its
+// heading turns, when map -> odom changes from `from` to `to`.
+inline MapToOdomDifference mapToOdomDifferenceAt(
+  const Eigen::Isometry3d & from,
+  const Eigen::Isometry3d & to,
+  const Eigen::Vector3d & pivot_in_odom)
+{
+  return {
+    (to * pivot_in_odom - from * pivot_in_odom).norm(),
+    absoluteYawDeg(to.linear() * from.linear().transpose())};
+}
+
+struct MapToOdomStep
+{
+  Eigen::Isometry3d map_to_odom{Eigen::Isometry3d::Identity()};
+  bool reached_target{true};
+};
+
+// One step from `from` toward `target`: the robot position moves by at most
+// max_translation_m and the heading turns by at most max_yaw_deg, the rotation
+// being about the robot.  Within both limits the step ends on the target itself.
+inline MapToOdomStep stepMapToOdomToward(
+  const Eigen::Isometry3d & from,
+  const Eigen::Isometry3d & target,
+  const Eigen::Vector3d & pivot_in_odom,
+  const MapToOdomStepParams & params)
+{
+  const Eigen::Vector3d robot_from = from * pivot_in_odom;
+  const Eigen::Vector3d displacement = target * pivot_in_odom - robot_from;
+  const Eigen::Matrix3d rotation = target.linear() * from.linear().transpose();
+  const double distance = displacement.norm();
+  const double yaw_deg = absoluteYawDeg(rotation);
+  const double translation_fraction =
+    params.max_translation_m > 0.0 && distance > params.max_translation_m ?
+    params.max_translation_m / distance : 1.0;
+  const double rotation_fraction =
+    params.max_yaw_deg > 0.0 && yaw_deg > params.max_yaw_deg ?
+    params.max_yaw_deg / yaw_deg : 1.0;
+  if (translation_fraction >= 1.0 && rotation_fraction >= 1.0) {
+    return {target, true};
+  }
+
+  // The whole relative rotation is scaled, so a tilt difference closes with the yaw.
+  Eigen::Matrix3d partial_rotation = rotation;
+  if (rotation_fraction < 1.0) {
+    const Eigen::AngleAxisd angle_axis(rotation);
+    partial_rotation = Eigen::AngleAxisd(
+      angle_axis.angle() * rotation_fraction, angle_axis.axis()).toRotationMatrix();
+  }
+  MapToOdomStep step;
+  step.reached_target = false;
+  step.map_to_odom.linear() = partial_rotation * from.linear();
+  // Turn about the robot, then move it along the displacement.
+  step.map_to_odom.translation() =
+    partial_rotation * (from.translation() - robot_from) + robot_from +
+    translation_fraction * displacement;
+  return step;
+}
+
+struct MapToOdomStepState
+{
+  bool initialized{false};
+  // The map -> odom broadcast last, and whether it is the target itself.
+  Eigen::Isometry3d published{Eigen::Isometry3d::Identity()};
+  bool published_is_target{true};
+  // The latest target and the robot position in odom the step was taken about.
+  Eigen::Isometry3d target{Eigen::Isometry3d::Identity()};
+  Eigen::Vector3d pivot_in_odom{Eigen::Vector3d::Zero()};
+  // Broadcasts at one stamp form one publish cycle: an accepted scan republishes
+  // the frozen anchor and then the new one at its stamp.  Each broadcast of the
+  // cycle steps from where the cycle started, so a cycle moves one step, toward
+  // its newest target.
+  double cycle_stamp_sec{std::numeric_limits<double>::quiet_NaN()};
+  Eigen::Isometry3d cycle_start{Eigen::Isometry3d::Identity()};
+};
+
+// The state after broadcasting toward `target` at stamp_sec.  Without a limit,
+// and on the first broadcast after a reset (a default-constructed state), the
+// broadcast is the target itself.
+inline MapToOdomStepState advanceMapToOdomStep(
+  const MapToOdomStepState & state,
+  const Eigen::Isometry3d & target,
+  const Eigen::Vector3d & pivot_in_odom,
+  double stamp_sec,
+  const MapToOdomStepParams & params)
+{
+  MapToOdomStepState next = state;
+  next.target = target;
+  if (pivot_in_odom.allFinite()) {
+    next.pivot_in_odom = pivot_in_odom;
+  }
+  next.cycle_stamp_sec = stamp_sec;
+  if (!state.initialized || !isMapToOdomStepLimitEnabled(params)) {
+    next.initialized = true;
+    next.published = target;
+    next.published_is_target = true;
+    next.cycle_start = target;
+    return next;
+  }
+  next.cycle_start = stamp_sec == state.cycle_stamp_sec ? state.cycle_start : state.published;
+  const MapToOdomStep step =
+    stepMapToOdomToward(next.cycle_start, target, next.pivot_in_odom, params);
+  next.published = step.map_to_odom;
+  next.published_is_target = step.reached_target;
+  return next;
+}
+
+// What is left between the broadcast map -> odom and the target, at the robot.
+inline MapToOdomDifference pendingMapToOdomStep(const MapToOdomStepState & state)
+{
+  if (!state.initialized || state.published_is_target) {
+    return {};
+  }
+  return mapToOdomDifferenceAt(state.published, state.target, state.pivot_in_odom);
+}
+
+inline std::vector<DiagnosticKeyValue> buildMapToOdomStepDiagnosticValues(
+  const MapToOdomStepState & state)
+{
+  const MapToOdomDifference pending = pendingMapToOdomStep(state);
+  return {
+    {"map_to_odom_pending_translation_m", std::to_string(pending.translation_m)},
+    {"map_to_odom_pending_yaw_deg", std::to_string(pending.yaw_deg)}};
+}
+
+}  // namespace lidar_localization
+
+#endif  // LIDAR_LOCALIZATION_MAP_TO_ODOM_STEP_POLICY_HPP_
