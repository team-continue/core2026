new file mode 100644
index 0000000..45d69d4
--- /dev/null
+++ b/include/lidar_localization/relative_fitness_policy.hpp
@@ -0,0 +1,96 @@
+#ifndef LIDAR_LOCALIZATION_RELATIVE_FITNESS_POLICY_HPP_
+#define LIDAR_LOCALIZATION_RELATIVE_FITNESS_POLICY_HPP_
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <deque>
+#include <limits>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "lidar_localization/alignment_diagnostics_policy.hpp"
+
+namespace lidar_localization
+{
+
+// Fitness limits relative to the recently accepted registrations.
+//
+// The absolute score_threshold has to admit every place and crowd the robot
+// meets, so it sits far above a good match: in the arena simulation a good
+// match scores 0.007 to 0.02 against a threshold of 2.0.  A registration that
+// locked onto the wrong place scores far worse than the recent good ones (0.7
+// to 0.95 there), yet still passes it.  The two decisions that hand over a
+// large correction -- the seed correction guard's consistent release and the
+// local re-acquisition proposal -- therefore also compare the fitness with the
+// median of the recently accepted ones.
+
+// How many accepted fitness values are kept, and how many the median needs.
+constexpr std::size_t kRecentFitnessWindow = 100;
+constexpr std::size_t kRecentFitnessMinSamples = 20;
+
+struct RelativeFitnessParams
+{
+  // The limit is max(floor, max_ratio x the median of the recent accepted
+  // fitness).  A max_ratio of 0 turns the limit off.
+  double max_ratio{0.0};
+  double floor{0.05};
+};
+
+// The recent accepted fitness after one more accept, trimmed to the window.
+inline std::deque<double> appendRecentFitness(const std::deque<double> & recent, double fitness)
+{
+  std::deque<double> next = recent;
+  if (!std::isfinite(fitness)) {
+    return next;
+  }
+  next.push_back(fitness);
+  while (next.size() > kRecentFitnessWindow) {
+    next.pop_front();
+  }
+  return next;
+}
+
+// The median of the recent accepted fitness (the upper one of an even count),
+// or nullopt with fewer than kRecentFitnessMinSamples values.
+inline std::optional<double> recentFitnessMedian(const std::deque<double> & recent)
+{
+  if (recent.size() < kRecentFitnessMinSamples) {
+    return std::nullopt;
+  }
+  std::vector<double> sorted(recent.begin(), recent.end());
+  const auto middle = sorted.begin() + static_cast<std::ptrdiff_t>(sorted.size() / 2);
+  std::nth_element(sorted.begin(), middle, sorted.end());
+  return *middle;
+}
+
+// The fitness limit, or +infinity while the limit is off or the median is not
+// known yet (then only the absolute threshold applies).
+inline double relativeFitnessLimit(
+  const RelativeFitnessParams & params, const std::deque<double> & recent)
+{
+  const auto median = recentFitnessMedian(recent);
+  if (!(params.max_ratio > 0.0) || !median) {
+    return std::numeric_limits<double>::infinity();
+  }
+  return std::max(params.floor, params.max_ratio * *median);
+}
+
+inline bool isRelativeFitnessParamsValid(const RelativeFitnessParams & params)
+{
+  return std::isfinite(params.max_ratio) && params.max_ratio >= 0.0 &&
+         std::isfinite(params.floor) && params.floor >= 0.0;
+}
+
+inline std::vector<DiagnosticKeyValue> buildRecentFitnessDiagnosticValues(
+  const std::deque<double> & recent)
+{
+  const auto median = recentFitnessMedian(recent);
+  return {{"recent_accepted_fitness_median",
+    median ? std::to_string(*median) : std::string("nan")}};
+}
+
+}  // namespace lidar_localization
+
+#endif  // LIDAR_LOCALIZATION_RELATIVE_FITNESS_POLICY_HPP_
