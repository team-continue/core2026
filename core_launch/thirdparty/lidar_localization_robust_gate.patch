@@ -0,0 +1,90 @@
+#ifndef LIDAR_LOCALIZATION_SEED_GUARD_RELEASE_POLICY_HPP_
+#define LIDAR_LOCALIZATION_SEED_GUARD_RELEASE_POLICY_HPP_
+
+#include <algorithm>
+#include <cstddef>
+#include <deque>
+#include <iterator>
+
+#include <Eigen/Geometry>
+
+#include "lidar_localization/map_to_odom_step_policy.hpp"
+#include "lidar_localization/measurement_gate_policy.hpp"
+
+namespace lidar_localization
+{
+
+// Consistent release of the seed correction guard.
+//
+// After seed_correction_guard_release_rejections consecutive rejections the
+// guard lets any correction through, so that a genuinely drifted odometry seed
+// can re-lock.  What gets through then can as well be an aliased match (a
+// crowd of robots around the sensor, a fast turn).  With
+// seed_correction_guard_release_min_consistent > 0 the release also needs the
+// gated result to agree with each of the newest min_consistent rejected
+// results on the map -> odom they imply: a real drift gives the same
+// map -> odom scan after scan, aliased matches scatter.
+
+// The map -> odom a registration result implies: the registered map -> base_link
+// composed with the inverse of the odom -> base_link the scan was seeded with.
+inline Eigen::Isometry3d candidateMapToOdom(
+  const Eigen::Isometry3d & registered_map_to_base,
+  const Eigen::Isometry3d & seed_odom_to_base)
+{
+  return registered_map_to_base * seed_odom_to_base.inverse();
+}
+
+// How many rejected candidates the release check reads (and keeps).
+inline std::size_t seedGuardReleaseHistoryLength(const MeasurementGateParams & params)
+{
+  return static_cast<std::size_t>(std::max(0, params.seed_correction_guard_release_min_consistent));
+}
+
+// Whether `candidate` (the gated result's map -> odom) lies within the
+// consistency tolerances of each of the newest min_consistent rejected
+// candidates (ordered oldest first), measured at the robot (robot_in_odom, see
+// mapToOdomDifferenceAt).  Always true while the check is off.
+inline bool isSeedGuardReleaseConsistent(
+  const MeasurementGateParams & params,
+  const std::deque<Eigen::Isometry3d> & rejected_candidates,
+  const Eigen::Isometry3d & candidate,
+  const Eigen::Vector3d & robot_in_odom)
+{
+  const std::size_t needed = seedGuardReleaseHistoryLength(params);
+  if (needed == 0) {
+    return true;
+  }
+  if (rejected_candidates.size() < needed) {
+    return false;
+  }
+  const auto first = std::prev(rejected_candidates.end(), static_cast<std::ptrdiff_t>(needed));
+  return std::all_of(
+    first, rejected_candidates.end(),
+    [&](const Eigen::Isometry3d & rejected) {
+      const MapToOdomDifference difference =
+        mapToOdomDifferenceAt(rejected, candidate, robot_in_odom);
+      return difference.translation_m <=
+             params.seed_correction_guard_release_consistency_translation_m &&
+             difference.yaw_deg <= params.seed_correction_guard_release_consistency_yaw_deg;
+    });
+}
+
+// The rejected candidates after one more rejection, trimmed to what the check
+// reads.  Accepts and resets clear the history.
+inline std::deque<Eigen::Isometry3d> appendRejectedCandidate(
+  const std::deque<Eigen::Isometry3d> & rejected_candidates,
+  const Eigen::Isometry3d & candidate,
+  const MeasurementGateParams & params)
+{
+  std::deque<Eigen::Isometry3d> next = rejected_candidates;
+  next.push_back(candidate);
+  const std::size_t keep = seedGuardReleaseHistoryLength(params);
+  while (next.size() > keep) {
+    next.pop_front();
+  }
+  return next;
+}
+
+}  // namespace lidar_localization
+
+#endif  // LIDAR_LOCALIZATION_SEED_GUARD_RELEASE_POLICY_HPP_
