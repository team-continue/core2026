+geometry_msgs::msg::TransformStamped PCLLocalization::stepPublishedMapToOdom(
+  const geometry_msgs::msg::TransformStamped & target,
+  const geometry_msgs::msg::TransformStamped * odom_to_base_link)
+{
+  if (!lidar_localization::isMapToOdomStepLimitEnabled(map_to_odom_step_params_)) {
+    return target;
+  }
+  // The step turns about the robot. A pose a scan old is close enough for that;
+  // the latest transform needs no wait, and without one the last pivot is kept.
+  Eigen::Vector3d robot_in_odom = map_to_odom_step_.pivot_in_odom;
+  if (odom_to_base_link != nullptr) {
+    robot_in_odom = tf2::transformToEigen(*odom_to_base_link).translation();
+  } else {
+    try {
+      robot_in_odom = tf2::transformToEigen(
+        tfbuffer_.lookupTransform(odom_frame_id_, base_frame_id_, tf2::TimePointZero))
+        .translation();
+    } catch (const tf2::TransformException & ex) {
+      RCLCPP_WARN_THROTTLE(
+        get_logger(), *get_clock(), 5000,
+        "map -> odom step limit: no %s -> %s transform (%s); stepping about the last robot "
+        "position", odom_frame_id_.c_str(), base_frame_id_.c_str(), ex.what());
+    }
+  }
+  map_to_odom_step_ = lidar_localization::advanceMapToOdomStep(
+    map_to_odom_step_, tf2::transformToEigen(target), robot_in_odom,
+    stamp_to_sec(target.header.stamp), map_to_odom_step_params_);
+  if (map_to_odom_step_.published_is_target) {
+    return target;
+  }
+  geometry_msgs::msg::TransformStamped published =
+    tf2::eigenToTransform(map_to_odom_step_.published);
+  published.header = target.header;
+  published.child_frame_id = target.child_frame_id;
+  return published;
+}
