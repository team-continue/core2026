diff --git a/include/lidar_localization/motion_gate_policy.hpp b/include/lidar_localization/motion_gate_policy.hpp
new file mode 100644
index 0000000..6913f59
--- /dev/null
+++ b/include/lidar_localization/motion_gate_policy.hpp
@@ -0,0 +1,118 @@
+#ifndef LIDAR_LOCALIZATION_MOTION_GATE_POLICY_HPP_
+#define LIDAR_LOCALIZATION_MOTION_GATE_POLICY_HPP_
+
+#include <cmath>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include <Eigen/Geometry>
+
+#include "lidar_localization/alignment_diagnostics_policy.hpp"
+
+namespace lidar_localization
+{
+
+// Motion-aware skip of the registration.
+//
+// While the robot turns or drives fast, the odometry seed is least certain and
+// an aliased registration result is most likely.  The motion at a scan is
+// estimated from the odom -> base_link of its odometry seed and of the previous
+// scan's.  Above a limit the registration result is not used: map -> odom stays
+// frozen as on a rejected scan, but the scan counts neither as a rejection (the
+// rejection streak drives the guard release, re-acquisition and the
+// reinitialization request) nor as a candidate for the seed correction guard's
+// consistent release.
+
+constexpr double kMotionGatePi = 3.14159265358979323846;
+
+// Odometry seeds further apart than this do not describe the motion at a scan.
+constexpr double kMotionGateMaxSeedIntervalSec = 1.0;
+
+struct MotionGateParams
+{
+  // 0 disables the corresponding limit.
+  double max_yaw_rate_rad_s{0.0};
+  double max_speed_mps{0.0};
+};
+
+inline bool isMotionGateEnabled(const MotionGateParams & params)
+{
+  return params.max_yaw_rate_rad_s > 0.0 || params.max_speed_mps > 0.0;
+}
+
+// The odom -> base_link a scan was seeded with, at the scan stamp.
+struct TimedOdomToBase
+{
+  double stamp_sec{std::numeric_limits<double>::quiet_NaN()};
+  Eigen::Isometry3d odom_to_base{Eigen::Isometry3d::Identity()};
+};
+
+struct SeedMotionEstimate
+{
+  bool valid{false};
+  double yaw_rate_rad_s{std::numeric_limits<double>::quiet_NaN()};
+  double speed_mps{std::numeric_limits<double>::quiet_NaN()};
+};
+
+// Yaw rate (absolute, from the wrapped yaw change) and planar speed between two
+// odometry seeds.  Invalid unless the later seed follows within
+// kMotionGateMaxSeedIntervalSec.
+inline SeedMotionEstimate estimateSeedMotion(
+  const TimedOdomToBase & previous,
+  const TimedOdomToBase & current)
+{
+  SeedMotionEstimate estimate;
+  const double dt_sec = current.stamp_sec - previous.stamp_sec;
+  if (
+    !std::isfinite(dt_sec) || dt_sec <= 0.0 || dt_sec > kMotionGateMaxSeedIntervalSec ||
+    !previous.odom_to_base.matrix().allFinite() || !current.odom_to_base.matrix().allFinite())
+  {
+    return estimate;
+  }
+  const auto yaw = [](const Eigen::Isometry3d & pose) {
+      return std::atan2(pose.linear()(1, 0), pose.linear()(0, 0));
+    };
+  const double yaw_change = std::remainder(
+    yaw(current.odom_to_base) - yaw(previous.odom_to_base), 2.0 * kMotionGatePi);
+  const Eigen::Vector2d planar_motion =
+    (current.odom_to_base.translation() - previous.odom_to_base.translation()).head<2>();
+  estimate.valid = true;
+  estimate.yaw_rate_rad_s = std::abs(yaw_change) / dt_sec;
+  estimate.speed_mps = planar_motion.norm() / dt_sec;
+  return estimate;
+}
+
+struct MotionGateDecision
+{
+  bool active{false};
+  // The estimate the decision read (NaN without one).
+  double yaw_rate_rad_s{std::numeric_limits<double>::quiet_NaN()};
+  double speed_mps{std::numeric_limits<double>::quiet_NaN()};
+};
+
+inline MotionGateDecision decideMotionGate(
+  const MotionGateParams & params,
+  const SeedMotionEstimate & estimate)
+{
+  MotionGateDecision decision;
+  decision.yaw_rate_rad_s = estimate.yaw_rate_rad_s;
+  decision.speed_mps = estimate.speed_mps;
+  decision.active = estimate.valid &&
+    ((params.max_yaw_rate_rad_s > 0.0 && estimate.yaw_rate_rad_s > params.max_yaw_rate_rad_s) ||
+    (params.max_speed_mps > 0.0 && estimate.speed_mps > params.max_speed_mps));
+  return decision;
+}
+
+inline std::vector<DiagnosticKeyValue> buildMotionGateDiagnosticValues(
+  const MotionGateDecision & decision)
+{
+  return {
+    {"motion_gate_active", boolString(decision.active)},
+    {"motion_gate_yaw_rate_rad_s", std::to_string(decision.yaw_rate_rad_s)},
+    {"motion_gate_speed_mps", std::to_string(decision.speed_mps)}};
+}
+
+}  // namespace lidar_localization
+
+#endif  // LIDAR_LOCALIZATION_MOTION_GATE_POLICY_HPP_
